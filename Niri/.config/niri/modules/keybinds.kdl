// -------------------
// KEYBINDINGS
// -------------------

binds {
    // ---- General & System ---------------------------------------------------
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E     { quit; }
    Mod+Shift+P     { power-off-monitors; }
    Mod+Escape hotkey-overlay-title="Open Overview" repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Ctrl+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Exit niri / session management
    Ctrl+Alt+Delete { spawn-sh "if uwsm check is-active >/dev/null 2>&1; then uwsm stop; else niri msg action quit; fi"; }

    // ---- Window Actions -----------------------------------------------------
    Mod+Q { spawn-sh "~/.config/niri/scripts/whatsapp-control.sh hide"; }// includes { close-window; } action
    Mod+P { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Column / Window sizing & layout
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }
    Mod+Ctrl+WheelScrollDown { set-window-height "-5%"; }
    Mod+Ctrl+WheelScrollUp   { set-window-height "+5%"; }

    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
   // Mod+M      { maximize-window-to-edges; }
    Mod+M      { maximize-column; }
    Mod+F      { fullscreen-window; }
    Mod+Shift+F { maximize-column; }

    // Consume / Expel
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // ---- Navigation & Focus -------------------------------------------------
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-workspace-down; }
    Mod+K     { focus-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-column-to-workspace-down; }
    Mod+Shift+K     { move-column-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // Monitor Focus & Movement
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+L     { focus-monitor-right; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+J     { focus-monitor-down; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    // Mouse Wheel Navigation
    Mod+WheelScrollDown      cooldown-ms=100 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=100 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=100 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=100 { move-column-to-workspace-up; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Workspaces
    Mod+1 { focus-workspace "browser"; }
    Mod+2 { focus-workspace "vscode"; }
    Mod+3 { focus-workspace "general"; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace "browser"; }
    Mod+Shift+2 { move-column-to-workspace "vscode"; }
    Mod+Shift+3 { move-column-to-workspace "general"; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Tab { focus-workspace-previous; }
    Mod+Shift+Space hotkey-overlay-title="Special workspace" { focus-workspace "special"; }
    Alt+Tab         { focus-column-right; }
    Alt+Shift+Tab   { focus-column-left; }

    // ---- Application Launchers ----------------------------------------------
    Mod+Return hotkey-overlay-title="Open Terminal: foot" { spawn-sh "foot"; }
    Ctrl+L hotkey-overlay-title="lock screen" {spawn-sh "swaylock";}
    Mod+Alt+Return hotkey-overlay-title="Open Terminal: kitty" { spawn-sh "kitty"; }
    Mod+Space hotkey-overlay-title="Open menu: Rofi" { spawn-sh "rofi -show drun"; }
    Mod+A hotkey-overlay-title="Open App Launcher: vicinae" { spawn-sh "vicinae toggle"; }
    Mod+B hotkey-overlay-title="Open Browser: firefox" { spawn-sh "firefox"; }
    Mod+Alt+B hotkey-overlay-title="Open Secondary Browser: chrome" { spawn-sh "firefox --enable-features=TouchpadOverscrollHistoryNavigation"; }
    Mod+E hotkey-overlay-title="File Manager: Thunar" { spawn-sh "thunar"; }
    Mod+Alt+E hotkey-overlay-title="File Manager: Yazi" { spawn-sh "yazi"; }
    Mod+Alt+C { spawn-sh "code"; }
    Mod+Alt+M { spawn-sh "spotify-launcher"; }
    Mod+Shift+M { spawn-sh "foot --app-id footfloat cava"; }
    Mod+Shift+T { spawn-sh "foot --app-id footfloat1 tty-clock -c -C 2"; }
    Mod+D { spawn-sh "vesktop"; }
    Mod+W hotkey-overlay-title="Toggle WhatsApp" { spawn-sh "~/.config/niri/scripts/whatsapp-control.sh toggle"; }

    // ---- Utility & Media ----------------------------------------------------
    Mod+Shift+Q hotkey-overlay-title="Lock Screen: gtklock" { spawn-sh "gtklock"; }
    Mod+Alt+Y hotkey-overlay-title="Open Wallpaper Selector" { spawn-sh "$HOME/.config/scripts/bgselector.sh"; }
    Mod+Shift+W hotkey-overlay-title="Random Wallpaper Now" { spawn-sh "~/.config/niri/scripts/wallpaper_change.sh"; }

    Mod+V { spawn-sh "copyq toggle"; }
    Mod+Alt+Period { spawn-sh "rofimoji --action copy"; }
    Mod+N { spawn-sh "swaync-client -t"; }
    Mod+Shift+N { spawn-sh "swaync-client -C"; }

    // Screenshots
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Screen Recording
    Mod+Alt+R hotkey-overlay-title="Record region (no sound)" { spawn-sh "~/.config/niri/scripts/record.sh"; }
    Mod+Shift+Alt+R hotkey-overlay-title="Record region (with sound)" { spawn-sh "~/.config/niri/scripts/record.sh --sound"; }
    Ctrl+Alt+R hotkey-overlay-title="Record screen (no sound)" { spawn-sh "~/.config/niri/scripts/record.sh --fullscreen"; }
    Mod+Shift+Ctrl+Alt+R hotkey-overlay-title="Record screen (with sound)" { spawn-sh "~/.config/niri/scripts/record.sh --fullscreen-sound"; }

    // Hardware / Media Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "swayosd-client" "--input-volume"  "mute-toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    XF86PowerOff allow-when-locked=true { spawn-sh "~/.config/wlogout/launch.sh"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    F7 { spawn "bash" "-c" "~/.config/niri/scripts/toggle_touchpad.sh"; }
    Mod+F7 { spawn "bash" "-c" "~/.config/niri/scripts/toggle_touchscreen.sh"; }

    // Application Restarts
    Mod+Alt+W    { spawn "sh" "-c" "pgrep -x waybar >/dev/null && killall waybar || waybar &"; }
    Ctrl+Shift+B { spawn-sh "fish -c \"pkill -x waybar; waybar &\""; }
}
